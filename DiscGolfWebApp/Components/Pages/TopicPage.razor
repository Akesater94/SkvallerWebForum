@page "/topics/{TopicId:int}"
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Skvaller.Models
@using Skvaller.Services
@inject IPostApiService PostApiService
@inject IPostService PostService
@inject AuthenticationStateProvider AuthProvider

@if(topic is null)
{
	<p>Laddar...</p>
}
else
{
	<h2>@topic.Name</h2>

	@if(userId is not null)
	{
		<div class="card mb-4">
			<div class="card-body">
				<input class="form-control mb-2" placeholder="Rubrik" @bind="newTitle" />
				<textarea class="form-control mb-2" rows="4" placeholder="Skriv ditt inlägg..."
						  @bind="newContent"></textarea>
				<button class="btn btn-primary" @onclick="CreatePostAsync">Skapa inlägg</button>
			</div>
		</div>
	}
	else
	{
		<p>Logga in för att skapa ett inlägg.</p>
	}

	@if (!string.IsNullOrEmpty(Error))
	{
		<div class="alert alert-warning">@Error</div>
	}

	@if (posts.Count == 0)
	{
		<p>Inga inlägg ännu.</p>
	}
	@foreach (var post in posts)
	{
		<div class="card mb-2">
			<div class="card-body d-flex justify-content-between align-items-start">
				<div>
					<h5><a href="/posts/@post.Id">@post.Title</a></h5>
					<AuthorInfo Name="@post.AuthorName" Date="@post.CreatedAt"></AuthorInfo>
				</div>
				@if (isAdmin || post.AuthorId == userId)
				{
					<button class="btn btn-sm btn-outline-danger"
							@onclick="() => DeletePostAsync(post)">
						Ta bort inlägg
					</button>
				}
			</div>
		</div>
	}
}

@code {
	[Parameter]
	public int TopicId { get; set; }


	private Topic? topic;
	private List<PostResponse> posts = new();
	private string? Error;
	private string newTitle = "";
	private string newContent = "";
	private string? userId;
	private bool isAdmin;

	protected override async Task OnInitializedAsync()
	{
		var state = await AuthProvider.GetAuthenticationStateAsync();
		userId = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
		isAdmin = state.User.IsInRole("Admin");

		topic = await PostService.GetTopicAsync(TopicId);
		await LoadPostsAsync();
	}

	private async Task LoadPostsAsync()
	{
		try
		{
			posts = await PostApiService.GetPostsByTopicAsync(TopicId) ?? new List<PostResponse>();
			Error = null;
		}
		catch (HttpRequestException)
		{
			Error = "Kunde inte hämta inläggen just nu.";
		}
	}

	private async Task CreatePostAsync()
	{

		if(userId != null)
		{
			if(string.IsNullOrEmpty(newTitle) || string.IsNullOrWhiteSpace(newTitle) || string.IsNullOrWhiteSpace(newContent) || string.IsNullOrWhiteSpace(newContent))
			{
				Error = "Du måste ange rubrik och text.";
			}
			else
			{
				await PostService.CreatePostAsync(TopicId, userId, newTitle, newContent);
				newTitle = "";
				newContent = "";
				await LoadPostsAsync();
			}
		}
	}

	private async Task DeletePostAsync(PostResponse post)
	{
		if(userId != null)
		{
			await PostService.DeletePostAsync(post.Id, userId, isAdmin);
			await LoadPostsAsync();
		}
	}
}
